Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Real files and directories are served as they are
  #    (assets, images, api.php, sitemap.xml, the home page).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Prerendered pages: /about -> about.html,
  #    /products/chama-loans -> products/chama-loans.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 3. The admin area is a client-rendered app with its own empty shell.
  RewriteRule ^admin(/.*)?$ app.html [L]
</IfModule>

# Server-only files must never be downloadable: the local database
# settings (config.local.php), dumps and data files.
<FilesMatch "(^config\.local\.php$|\.sql$|^db\.json$)">
  Require all denied
</FilesMatch>

# Anything that reaches this point does not exist: answer with a real 404.
ErrorDocument 404 /404.html

# Serve the web app manifest with its proper type
AddType application/manifest+json .webmanifest

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>

# Set headers for security and caching
<IfModule mod_headers.c>
  # Prevent browser caching for HTML files
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Keep the admin area and the API out of search results.
  <FilesMatch "^(app\.html|api\.php)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # No CORS headers here on purpose: api.php sends them itself, and only to
  # the site's own origins. A "Header set" in this file would override that.
</IfModule>
