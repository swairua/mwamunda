# API Configuration
# For local development: Use the relative path to the API
# For production: Set to the full URL of your production server

# Local development (default)
# VITE_API_BASE_URL=/api.php

# Production
# VITE_API_BASE_URL=https://mwamunda.ziratech.com/api.php

# Database Configuration (for backend/PHP API)
# These are used by the PHP backend (api.php) if hosting on a PHP server
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=mwamunda
