# API Configuration
# Default: /api.php (relative path)
#
# Local development:
#   - Vite dev server proxies /api.php → https://mwamunda.ziratech.com
#   - No environment variable needed (uses default)
#
# Production (fly.dev or other):
#   - Must set VITE_API_BASE_URL during build
#   - If API is on same origin, use: /api.php
#   - If API is external, use: https://mwamunda.ziratech.com/api.php

VITE_API_BASE_URL=https://mwamunda.ziratech.com/api.php

# Database Configuration (for backend/PHP API)
# These are used by the PHP backend (api.php) if hosting on a PHP server
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=mwamunda
