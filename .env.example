# ---------------------------------------------------------------
# Front end (read by Vite at build time)
# ---------------------------------------------------------------
# Where the browser finds the API. Default: /api.php on the same origin.
#   - Local development: leave unset. Vite proxies /api.php to
#     http://localhost:8000 (npm run dev:api, or npm run dev:php).
#   - Production: keep it same-origin. The admin session cookie is
#     SameSite=Strict, so an API on another site cannot receive it.
VITE_API_BASE_URL=/api.php

# ---------------------------------------------------------------
# Local mock API (api-server.js) - optional
# ---------------------------------------------------------------
# The first admin for local work. If unset, one is generated and its
# password is printed once when the mock starts with an empty db.json.
# DEV_ADMIN_EMAIL=you@example.test
# DEV_ADMIN_PASSWORD=choose-a-long-password

# ---------------------------------------------------------------
# PHP API (api.php / connection.php) - set on the server, not in Vite
# ---------------------------------------------------------------
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=mwamunda
#
# Origins allowed to call the API from a browser, comma separated.
# Requests from the host that serves api.php are always allowed.
# Default: https://mwamunda.co.ke,https://www.mwamunda.co.ke
# ALLOWED_ORIGINS=https://mwamunda.co.ke,https://www.mwamunda.co.ke
#
# Set to "development" only on a local machine: it lets the session cookie
# work over plain http and lets connection.php fall back to a local root
# database login. Anything else (or unset) means production.
# APP_ENV=production
#
# Only behind a proxy or CDN, and only if every request comes through it:
# the header it sets with the visitor's address, used for login rate limiting.
# See PRODUCTION_DEPLOYMENT.md before setting this.
# TRUSTED_PROXY_IP_HEADER=X-Forwarded-For
