# API Configuration
# Default: /api.php (same origin - api.php is deployed next to index.html)
#
# Local development:
#   - Vite dev server proxies /api.php -> http://localhost:8000
#   - Start PHP with: php -S localhost:8000
#   - No environment variable needed (uses default)
#
# Production (shared Apache hosting at domain root):
#   - Use /api.php (same domain)
#   - If the API is on a different origin, set its full URL here

VITE_API_BASE_URL=/api.php

# Database Configuration (used by PHP API via connection.php defaults)
# Override with host-level environment variables if your host supports them:
# DB_HOST=localhost
# DB_USER=mwamunda_web
# DB_PASSWORD=Mwamunda@2026
# DB_NAME=mwamunda_web
